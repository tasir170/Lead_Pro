# ==============================================================================
# LeadPulse AI - Enterprise Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# Core AI Intelligence (Gemini API)
# ------------------------------------------------------------------------------
# Required for 7-factor predictive lead scoring, company research dossiers,
# multi-agent workflow orchestration, AI sales assistant, and WhatsApp copywriting.
# AI Studio automatically injects this from user secrets at runtime.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# ------------------------------------------------------------------------------
# Application Hosting & Base URL
# ------------------------------------------------------------------------------
# Injected at runtime with Cloud Run or custom host domain.
APP_URL="https://ais-dev-bfmcqylrpcdwukdnixxbir-180954597671.us-east1.run.app"
PORT=3000
NODE_ENV="development"

# ------------------------------------------------------------------------------
# Meta WhatsApp Business Platform (Cloud API) - Optional
# ------------------------------------------------------------------------------
# 1-click wa.me messaging works out of the box with zero credentials.
# Configure these only if you want automated backend API dispatch without opening WhatsApp.
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""

# ------------------------------------------------------------------------------
# Real Business Discovery & Search Providers - Optional
# ------------------------------------------------------------------------------
# When unconfigured, the discovery engine uses high-fidelity verified directory data.
GOOGLE_PLACES_API_KEY=""
HUNTER_API_KEY=""
CLEARBIT_API_KEY=""
